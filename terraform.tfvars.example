# Template only. Real values are kept outside this repo.
hmd_account_id = "<HMD_ACCOUNT_ID>"

# Naming: resources are named <project>-<environment>-<resource>, e.g. app-prod-vpc
project     = "app"
environment = "prod"

# Network
vpc_cidr = "<VPC_CIDR>"
subnet_cidrs = {
  public_1a  = "<CIDR>"
  public_1b  = "<CIDR>"
  private_1a = "<CIDR>"
  private_1b = "<CIDR>"
  db_1a      = "<CIDR>"
  db_1b      = "<CIDR>"
}

# VPC peering (HMD side)
kaha_peering_connection_id  = "<PEERING_ID>"
kaha_vpc_cidr               = "<KAHA_VPC_CIDR>"
atlas_peering_connection_id = "<PEERING_ID>"
atlas_cidr                  = "<ATLAS_CIDR>"

# S3 buckets
user_static_bucket_name = "<BUCKET_NAME>"
cloudtrail_bucket_name  = "<BUCKET_NAME>"
config_bucket_name      = "<BUCKET_NAME>"

# ALB
certificate_arn   = "<ACM_CERTIFICATE_ARN>"
app_port          = 80
health_check_path = "/"

# App server
app_instance_type = "t3a.micro"
app_ami_id        = "<AMI_ID>"

# Alerts
alert_emails = ["<EMAIL>"]

# OpenVPN
openvpn_ami_id   = "<AMI_ID>"
vpn_client_cidrs = ["<CIDR>"]
vpn_admin_cidrs  = ["<CIDR>"]
